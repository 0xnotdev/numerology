# Runtime
APP_ENV=development
APP_ORIGIN=http://localhost:3000
APP_VERSION=0.1.0
LOG_LEVEL=info

# Persistence
DATABASE_URL=postgresql://numerology:numerology@127.0.0.1:5432/numerology
TEST_DATABASE_URL=postgresql://numerology:numerology@127.0.0.1:5432/numerology_test
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_READINESS_TIMEOUT_MS=75

# Local-development field protection only. Never reuse these public fixture keys outside local/test.
FIELD_PROTECTION_KEY_ID=local-checkpoint-1
FIELD_PROTECTION_KEY_VERSION=1
FIELD_PROTECTION_KEK_BASE64=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
FIELD_LOOKUP_HMAC_KEY_BASE64=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# External services are added only in the checkpoint that integrates them.
