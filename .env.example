# Runtime
APP_ENV=development
APP_ORIGIN=http://localhost:3000
APP_VERSION=0.1.0
LOG_LEVEL=info
CUSTOMER_RUNTIME_ENABLED=false

# Intake privacy activation is deliberately opt-in. Set these only after the identity, contact,
# and notice have been reviewed for the deployment; placeholder addresses are rejected at runtime.
PRIVACY_REVIEWED=false
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_NOTICE_VERSION=
AUTH_FROM_EMAIL=
DRAFT_COOKIE_SECRET=
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
MAINTENANCE_BEARER_SECRET=

# Persistence
DATABASE_URL=postgresql://numerology:numerology@127.0.0.1:5432/numerology
TEST_DATABASE_URL=postgresql://numerology:numerology@127.0.0.1:5432/numerology_test
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=2000
DATABASE_READINESS_TIMEOUT_MS=75

# Local-development field protection only. Never reuse these public fixture keys outside local/test.
FIELD_PROTECTION_KEY_ID=local-checkpoint-1
FIELD_PROTECTION_KEY_VERSION=1
FIELD_PROTECTION_KEK_BASE64=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
FIELD_LOOKUP_HMAC_KEY_BASE64=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# Production-only AWS KMS keys. Never enable CUSTOMER_RUNTIME with local fixture keys.
FIELD_PROTECTION_KMS_KEY_ID=
FIELD_LOOKUP_KMS_KEY_ID=

# External services are added only in the checkpoint that integrates them.

# Checkpoint 8 payments are test-mode only. Leave disabled without real Razorpay test credentials.
# The API key secret and webhook secret must be different and must never be exposed to the browser.
PAYMENTS_RUNTIME_ENABLED=false
# Test-mode adapter only. CP8 rejects rzp_live_* keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_INTERNAL_BEARER_SECRET=
RAZORPAY_CHECKOUT_NAME=Numerology Report
RAZORPAY_CHECKOUT_DESCRIPTION=Personal numerology report
