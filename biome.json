{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/coverage",
      "!!**/node_modules",
      "!!data/doctrine/releases/*.compiled.json",
      "!!data/doctrine/releases/*.manifest.json",
      "!!data/report/fixtures/*.expected.json",
      "!!data/report/eval-results.expected.json",
      "!!packages/database/migrations/meta/*_snapshot.json",
      "!!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
